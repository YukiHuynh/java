package bean;

public class Dish {

	public enum Kind {
		MEAT, FISH, OTHER
	}
	
	private String id;
	private String name;
	private double calories;
	private Kind kind;
	private boolean vegetarian;
	
	public Dish() {
	}

	public Dish(String id, String name, double calories, Kind kind, boolean vegetarian) {
		this.id = id;
		this.name = name;
		this.calories = calories;
		this.kind = kind;
		this.vegetarian = vegetarian;
	}
	
}
