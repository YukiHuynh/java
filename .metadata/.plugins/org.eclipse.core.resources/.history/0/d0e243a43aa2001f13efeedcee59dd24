package chapter06;

import java.util.List;
import java.util.Map;
import java.util.stream.Collectors;

import bean.Dish;

public class Partitioning {

	static List<Dish> menu = Dish.menu;
	
	public static void main(String[] args) {
		
		List<Dish> vegetarianDishes = partitionByVegetarian().get(true);
		
		// Achieved the same result with filter()
		vegetarianDishes = menu.stream().filter(Dish::isVegetarian).collect(Collectors.toList())
		System.out.println("Partitioning menu by vegeterian: " + vegetarianDishes);
		
	}
	
	private static Map<Boolean, List<Dish>> partitionByVegetarian() {
		return menu.stream().collect(Collectors.partitioningBy(Dish::isVegetarian));
	}
	
}
