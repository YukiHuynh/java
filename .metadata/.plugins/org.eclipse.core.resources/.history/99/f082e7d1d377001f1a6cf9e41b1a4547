package design_patterns.builder.bankaccount_example;

public class BankAccount {

	private final String name; // required
	private final String accountName; // requried
	private final String address;
	private final String email;
	private final boolean newsletter;
	private final boolean mobileBanking;
	
	public BankAccount(String name, String accountName, String address, String email, boolean newsletter,
			boolean mobileBanking) {
		this.name = name;
		this.accountName = accountName;
		this.address = address;
		this.email = email;
		this.newsletter = newsletter;
		this.mobileBanking = mobileBanking;
	}
	
	
	
}
