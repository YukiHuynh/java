package stack_and_queue.queue;

public class Main {

	public static void main(String[] args) {
		
		Queue queue = new Queue(10); // Initialize a queue with capacity 10
		
		queue.push(10);
		queue.push(20);
		queue.push(30);
		
		// Display queue
		queue.display();
		System.out.println(queue);
		
		// Pop elements from the queue
        System.out.println("Popped: " + queue.pop());
        queue.display();
        System.out.println(queue);

        System.out.println("Popped: " + queue.pop());
        queue.display();
        System.out.println(queue);

        System.out.println("Popped: " + queue.pop());
        queue.display();
        System.out.println(queue);

        // Test popping from an empty queue
        System.out.println("Popped: " + queue.pop());
		
	}
	
}
