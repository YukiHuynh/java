package recursion;

public class TowerOfHaNoi {

	public static void main(String[] args) {
		int n = 3; // Số đĩa (có thể thay đổi)
        int x = 1; // Cọc nguồn (source)
        int y = 3; // Cọc đích (destination)
        
        System.out.println("Giải thuật Tháp Hà Nội cho " + n + " đĩa:");
        Move(n, x, y);
	}
	
	private static void move(int n, int x, int y) {
		if(n == 1) {
			System.out.println("Chuyển 1 đĩa từ " + x + " sang " + y);
		} else {
			move(n-1, x, 6 - x -y);
			move(1, x, y);
			move(n - 1, 6 - x -y, y);
		}
	}
	
}
