package recursion;

public class Factorial {

	public static void main(String[] args) {
		System.out.println(factorial(3));
	}
	
	private static int factorial(int n) {
		int result = 0;
		while(n >= 0) {
			if(n == 0) {
				return 1;
			} else {
				result = n * factorial(n -1);
			}
		}
		return result;
	}
	
}
