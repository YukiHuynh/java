package searching;

import java.util.Objects;

import bean.BSTNode;

public class BinarySearchTree {

	private BSTNode root;
	
	public BinarySearchTree() {
	}
	
	private void insert(int key) {
		root = insertRec(root, key);
	}
	
	private BSTNode insertRec(BSTNode node, int key) {
		if(node == null) {
			return new BSTNode(key);
		}
		
		if(key < node.getKey()) {
			node.setLeft(insertRec(node.getLeft(), key));
		} else if(key > node.getKey()) {
			node.setRight(insertRec(node.getRight(), key));
		}
		return node;
	}
	
	/**
     * Tìm kiếm một khoá trong cây
     * @param key Khoá cần tìm
     * @return Nút chứa khoá nếu tìm thấy, null nếu không tìm thấy
     */
	public BSTNode search(int key) {
		return searchRec(root, key);
	}
	
	private BSTNode searchRec(BSTNode node; int key) {
	
	public BinarySearchTree(BSTNode root) {
		this.root = null;
	}

	public BSTNode getRoot() {
		return root;
	}

	public void setRoot(BSTNode root) {
		this.root = root;
	}

	@Override
	public int hashCode() {
		return Objects.hash(root);
	}

	@Override
	public boolean equals(Object o) {
		if (this == o) return true;
		if (o == null || getClass() != o.getClass()) return false;
		BinarySearchTree that = (BinarySearchTree) o;
		return Objects.equals(root, that.root);
	}

	@Override
	public String toString() {
		return "BinarySearchTree [root=" + root + "]";
	}
	
}

